# Copy to .env and edit. Everything is optional.

# Which LLM writes the final answer: none | anthropic | openai | ollama
SPF_LLM=none
# SPF_LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Embedding model: onnx (default, offline after first download) | hf | openai
SPF_EMBEDDINGS=onnx

# Use your own product CSV (same column names as data/products_raw.csv)
# SPF_DATA_CSV=data/my_products.csv
